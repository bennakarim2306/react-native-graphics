{
  "name": "gamefx-showcase",
  "version": "1.0.0",
  "main": "index",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.24",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-graphics": "file:vendor/react-native-graphics-0.0.0.tgz",
    "react-native-reanimated": "~4.7.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "web:prepare": "node -e \"require('fs').mkdirSync('public',{recursive:true});require('fs').copyFileSync(require.resolve('canvaskit-wasm/bin/full/canvaskit.wasm'),'public/canvaskit.wasm')\"",
    "export:web": "npm run web:prepare && expo export --platform web --output-dir dist-web"
  },
  "private": true
}
