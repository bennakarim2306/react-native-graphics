{
  "name": "gamefx-consumer-test",
  "version": "1.0.0",
  "private": true,
  "description": "An ordinary Expo app that integrates react-native-graphics from its packed tarball, like a third-party app. Installed outside the SDK repository by `npm run consumer:install` there.",
  "main": "index",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "npm run web:prepare && expo start --web",
    "typecheck": "tsc --noEmit",
    "check:imports": "node scripts/check-imports.mjs",
    "web:prepare": "node scripts/web-prepare.mjs",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "export:web": "npm run web:prepare && expo export --platform web --output-dir dist-web",
    "test:web": "node scripts/web-smoke.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.24",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-graphics": "file:vendor/react-native-graphics-0.1.0-rc.0.tgz",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
