{
  "name": "react-native-graphics",
  "version": "0.1.0-rc.0",
  "private": true,
  "description": "Embeddable 2D game-effects engine for React Native apps: particles, fire borders, explosions, throws, sprites, shaders and timelines on a transparent Skia overlay.",
  "license": "UNLICENSED",
  "keywords": [
    "react-native",
    "skia",
    "reanimated",
    "particles",
    "effects",
    "vfx",
    "animation",
    "game",
    "overlay",
    "expo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bennakarim2306/react-native-graphics.git"
  },
  "bugs": {
    "url": "https://github.com/bennakarim2306/react-native-graphics/issues"
  },
  "homepage": "https://github.com/bennakarim2306/react-native-graphics#readme",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./lib/module/index.js",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./lib/module/index.js",
      "browser": "./lib/module/index.js",
      "module": "./lib/module/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./core": {
      "types": "./lib/typescript/core.d.ts",
      "react-native": "./lib/module/core.js",
      "browser": "./lib/module/core.js",
      "module": "./lib/module/core.js",
      "default": "./lib/commonjs/core.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./lib/typescript/core.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "npm run typecheck && npm run lint && npm run test && npm run pack:verify",
    "pack:verify": "node scripts/verify-package.mjs",
    "example:pack": "node scripts/install-sdk.mjs example --pack-only",
    "example:install": "node scripts/install-sdk.mjs example",
    "consumer:install": "node scripts/install-consumer.mjs",
    "bench": "jest --config '{\"testEnvironment\":\"node\",\"rootDir\":\".\",\"roots\":[\"<rootDir>/scripts\"],\"testMatch\":[\"**/*.bench.ts\"]}' --verbose",
    "visual": "jest --config jest.visual.config.js",
    "bench:render": "jest --config jest.visual.config.js --testMatch '**/*.renderbench.ts'"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "^2.14.0",
    "react": ">=19.3.0",
    "react-native": ">=0.88.0",
    "react-native-reanimated": "^4.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/jest-preset": "^0.88.1",
    "@shopify/react-native-skia": "^2.14.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-jest": "^30.5.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "react": "^19.3.0",
    "react-native": "^0.88.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-worklets": "^0.13.0",
    "test-renderer": "^1.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
