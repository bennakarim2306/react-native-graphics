{
  "name": "react-native-graphics",
  "version": "0.0.0",
  "private": true,
  "description": "Embeddable 2D game-effects engine for React Native apps (particles, effects runtime, Skia rendering).",
  "license": "UNLICENSED",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core.d.ts",
      "default": "./lib/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__/**",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "example:pack": "npm run build && node -e \"require('fs').mkdirSync('example/vendor',{recursive:true})\" && npm pack --pack-destination example/vendor",
    "example:install": "npm run example:pack && cd example && npm install --no-audit --no-fund ./vendor/react-native-graphics-0.0.0.tgz",
    "bench": "jest --config '{\"testEnvironment\":\"node\",\"rootDir\":\".\",\"roots\":[\"<rootDir>/scripts\"],\"testMatch\":[\"**/*.bench.ts\"]}'"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "^2.14.0",
    "react": ">=19.0.0",
    "react-native": ">=0.86.0",
    "react-native-reanimated": "^4.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/jest-preset": "^0.88.1",
    "@shopify/react-native-skia": "^2.14.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-jest": "^30.5.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "react": "^19.3.0",
    "react-native": "^0.88.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-worklets": "^0.13.0",
    "test-renderer": "^1.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
